{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalTeX",
  "version": "0.1.0",
  "identifier": "pe.edu.utec.localtex",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalTeX",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": { "depends": ["texlive-scheme-medium", "latexmk"] }
    }
  }
}
